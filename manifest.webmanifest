{
  "name": "Blaty CNC",
  "short_name": "Blaty CNC",
  "description": "Rozsuwa blaty z pliku DXF i przygotowuje plik pod maszynę CNC.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f2f4f8",
  "theme_color": "#123c7c",
  "lang": "pl",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": ["application/zip", "application/x-zip-compressed", "application/octet-stream", "application/dxf", "image/vnd.dxf", "image/x-dxf", "text/plain", "application/*", "*/*", ".zip", ".dxf"]
        }
      ]
    }
  }
}
